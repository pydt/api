FROM public.ecr.aws/lambda/nodejs:22

# Amazon Linux 2023: dnf here is microdnf. R comes from the regular repos.
RUN dnf install -y \
      ImageMagick git make tar gzip findutils gcc gcc-c++ gcc-gfortran \
      java-17-amazon-corretto-headless \
      R-core R-core-devel \
      openssl-devel libcurl-devel libxml2-devel harfbuzz-devel fribidi-devel \
      freetype-devel libpng-devel libtiff-devel libjpeg-turbo-devel fontconfig-devel \
    && dnf clean all && rm -rf /var/cache/dnf

# Only what plot_map needs (see src/civ6_save_renderer/plot_map/config.vsh.yaml in civ6_pipeline)
RUN Rscript -e 'options(Ncpus = parallel::detectCores()); install.packages(c("ggforce", "yaml", "bit64", "ggnewscale", "cowplot", "readr", "purrr", "dplyr", "ggplot2", "tibble", "processx", "stringr", "remotes"), repos = "https://cloud.r-project.org")' \
    && Rscript -e 'for (p in c("ggforce", "yaml", "bit64", "ggnewscale", "cowplot", "readr", "purrr", "dplyr", "ggplot2", "tibble", "processx", "stringr")) if (!requireNamespace(p, quietly = TRUE)) stop("missing R package: ", p)'
# Pinned so a change upstream can't silently change rendering; bump deliberately
RUN Rscript -e 'remotes::install_github("rcannood/civ6saves@734365da57ddc6e3ad014bda6dae10bcebd6272a", upgrade = "never")' \
    && Rscript -e 'library(civ6saves)'

WORKDIR /
RUN git clone https://github.com/pydt/civ6_pipeline && cd civ6_pipeline && git checkout f05eeb01db03b800afb42b2364cb5d7bf0231891

# install node modules
RUN mkdir -p /home/node
WORKDIR /home/node
# Pinned to match api's civ6-save-parser; bump both together
RUN npm install civ6-save-parser@1.2.4

# viash needs java; pin to the version in civ6_pipeline's _viash.yaml
RUN curl -fsSL https://dl.viash.io | bash -s -- --tag 0.7.3 && mv viash /usr/local/bin

WORKDIR /civ6_pipeline
RUN viash ns build --parallel -p native

# make sure all files are readable globally for lambda
RUN chmod -R a+r /civ6_pipeline

WORKDIR ${LAMBDA_TASK_ROOT}
COPY node_handler/package.json .
COPY node_handler/package-lock.json .
RUN npm install --omit=dev
COPY node_handler/index.js .

CMD ["index.handler"]
